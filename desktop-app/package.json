{
  "name": "lazyoffice-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LazyOffice desktop prototype — chat a request, review the plan, approve, get a local document, spreadsheet, or presentation file.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.lazyoffice.desktop",
    "productName": "LazyOffice",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "engine.js",
      "docgen.js",
      "config-store.js",
      "setup-llm.js",
      "renderer/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "docx": "^9.0.0",
    "pptxgenjs": "^3.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
